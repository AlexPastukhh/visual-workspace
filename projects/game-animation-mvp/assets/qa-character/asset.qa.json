{
  "schema_version": 1,
  "asset_id": "gamebot-humanoid",
  "kind": "3d_scene",
  "project_root": "../..",
  "scene": "res://scenes/qa_character.tscn",
  "capture": {
    "fps": 24,
    "time_control": "qa_set_time",
    "duration_seconds": 8.0,
    "resolution": [1280, 720],
    "multiview_samples_per_phase": 4,
    "contact_sheet_max_frames": 24,
    "contact_sheet_columns": 6,
    "tile_size": [320, 180]
  },
  "actors": [
    {
      "id": "humanoid",
      "node_path": "Character",
      "dimension": "3d",
      "forward_axis": [0.0, 0.0, 1.0],
      "ground_y": 0.0,
      "ground_tolerance": 0.08,
      "character": {
        "skeleton_path": "gamebot_animated/GameBotRig/Skeleton3D",
        "animation_player_path": "gamebot_animated/AnimationPlayer",
        "animation_tree_path": "AnimationTree",
        "playback_property": "parameters/playback",
        "foot_bones": {
          "left": "Foot.L",
          "right": "Foot.R"
        },
        "motion_mode": "forward",
        "loop_states": ["Idle", "Walk", "Run"],
        "jump_state": "Jump",
        "landing_policy": "hold_final_pose_until_phase_end"
      }
    }
  ],
  "phases": [
    {
      "id": "idle",
      "start": 0.0,
      "end": 2.0,
      "focus": "Check stable idle pose and continuous loop playback."
    },
    {
      "id": "walk",
      "start": 2.0,
      "end": 4.0,
      "focus": "Check forward walking gait, alternating foot motion, foot height and planted-foot stability."
    },
    {
      "id": "run",
      "start": 4.0,
      "end": 6.0,
      "focus": "Check that run is distinct from walk, loops continuously and has readable foot lift and landing."
    },
    {
      "id": "jump",
      "start": 6.0,
      "end": 8.0,
      "focus": "Check takeoff, apex, landing, grounded state and the configured final-pose hold."
    }
  ],
  "qa_modules": ["common", "3d-character"],
  "dependencies": [
    "project.godot",
    "scenes/qa_character.tscn",
    "scripts/qa_character.gd",
    "assets/3d/gamebot_animated.glb"
  ]
}
